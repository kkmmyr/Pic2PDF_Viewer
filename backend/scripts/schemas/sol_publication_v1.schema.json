{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sol grounded publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_sha256", "candidate_sha256", "detailed_summary",
    "catalog_summary", "characters", "claims", "unresolved"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "sol-publication-v1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "detailed_summary": {"type": "string", "minLength": 800, "maxLength": 3000},
    "catalog_summary": {"type": "string", "minLength": 400, "maxLength": 700},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "fact_ids"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "fact_ids": {
            "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "artifact", "text", "fact_ids"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "artifact": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "fact_ids": {
            "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
