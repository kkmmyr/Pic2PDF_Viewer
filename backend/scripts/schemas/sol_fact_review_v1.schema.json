{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sol independent fact review v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "candidate_sha256", "review_run_id", "results"],
  "properties": {
    "schema_version": {"type": "string", "const": "sol-fact-review-v1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_run_id": {"type": "string", "minLength": 1},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "verdict", "evidence", "reason"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "verdict": {"type": "string", "enum": ["supported", "contradicted", "unsupported"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page_no", "quote"],
              "properties": {
                "page_no": {"type": "integer"},
                "quote": {"type": "string", "minLength": 20, "maxLength": 120}
              }
            }
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
