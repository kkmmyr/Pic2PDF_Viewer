{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sol fact quote-only repair v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_sha256", "repairs"],
  "properties": {
    "schema_version": {"type": "string", "const": "sol-fact-quote-repair-v1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "evidence_index", "quote"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "evidence_index": {"type": "integer", "minimum": 0},
          "quote": {"type": "string", "minLength": 20, "maxLength": 120}
        }
      }
    }
  }
}
