{
    "include": ["."],
    "exclude": [
        ".venv",
        "data",
        "__pycache__",
        "alembic",
        "tests",
        "scripts",
        "services/novel_db/ocr_worker.py"
    ],
    "venvPath": "..",
    "venv": ".venv",
    "extraPaths": ["../common/llm"],
    "pythonVersion": "3.12",
    "typeCheckingMode": "standard",
    "reportMissingImports": true,
    "reportMissingModuleSource": false,
    "reportUntypedFunctionDecorator": false
}
