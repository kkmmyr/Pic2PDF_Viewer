# ========================================
# プラットフォーム別セットアップ
# ========================================
#
# [Mac でコード編集 / テストを行う場合]
# 1. OCR 機能を使う場合は OCR_PYTHON を mac 用 venv の python に設定する:
#    OCR_PYTHON=/Users/<user>/.venv/ocr/bin/python
# 2. データディレクトリを Mac のパスで指定する:
#    PIC2PDF_DATA_DIR=/Users/<user>/Documents/Pic2PDF
# 3. Linux 同期は不要なので設定不要（デフォルト無効）
# 4. GEMMA_TOOL_DIR / VITE_GENERATE_API_URL は不要なら省略可
#
# [Windows（メイン環境）]
# 以下のデフォルト設定をそのままコピーして必要箇所を書き換えてください。

# ========================================
# バックエンド (FastAPI) 用の設定
# ========================================

# CORSで許可するオリジン（ドメイン）。カンマ区切りで複数のオリジンを指定できます。
# ローカル環境では、Reactのデフォルト開発サーバーアドレスを指定します。
ALLOWED_ORIGINS=http://localhost:5176,http://127.0.0.1:5176

# Gemma 4 ツールディレクトリ（web_extract モジュールの場所）。デフォルト: D:\61.tool\Gemma 4
# GEMMA_TOOL_DIR=D:\61.tool\Gemma 4

# ========================================
# データディレクトリ
# ========================================

# doujin / comic / kindle_novel / hitomi の共有データ置き場。
# 省略時: <repo>/backend/data/
# OneDrive 等の共有ストレージを指定すると複数端末でデータを共有できる。
# ※ SQLite / LanceDB ファイルはここに置かない（下記の専用変数で個別指定）
# PIC2PDF_DATA_DIR=C:\Users\<user>\OneDrive\61.tool\Pic2PDF

# 書誌メタ DB（meta.db）の格納ディレクトリ。
# 省略時: <repo>/backend/data/
# OneDrive 非推奨（SQLite WAL モードで同期競合による破損リスクあり）
# META_DB_DIR=D:\path\to\local\data

# Kindle 購入カタログ。通常運用では Linux サーバー側だけに設定する。
# 初回移行元は DB ファイルのみを指定し、旧アプリの画像は参照・移行しない。
# AMAZON_DATA_DIR=/opt/pic2pdf-viewer/import/kindle
# KINDLE_LEGACY_DB_PATH=/opt/pic2pdf-viewer/import/kindle/legacy/kindle.db
# KINDLE_CAPTURE_INBOX_DIR=/opt/pic2pdf-viewer/inbox/kindle-capture
# KINDLE_CAPTURE_AGENT_TOKEN=<十分に長いランダム値>
# KINDLE_CAPTURE_HEARTBEAT_TIMEOUT_SEC=300

# Windows キャプチャエージェント側だけに設定する。
# PIC2PDF_API_URL=http://medaroserver:8090
# KINDLE_CAPTURE_AGENT_ID=kindle-windows-1
# KINDLE_CAPTURE_INBOX_DIR=\\medaroserver\pic2pdf-capture-inbox

# 小説 RAG の SQLite DB（novel.db）の格納ディレクトリ。
# 省略時: <repo>/backend/data/novel_db/
# OneDrive 非推奨（同上）
# NOVEL_DB_DIR=D:\path\to\local\novel_db

# 小説 RAG の LanceDB ベクトルストアのパス。
# 省略時: <repo>/backend/data/novel.lancedb/
# OneDrive 非推奨（Arrow ファイルの同時書き込みで破損リスクあり）
# D: ドライブが exFAT の場合は NTFS ドライブ（C: 等）に置くこと
# NOVEL_DB_LANCE_PATH=C:\Users\<user>\AppData\Local\Pic2PDF\novel.lancedb

# LinuxサーバーのDB世代バックアップ。省略時はPIC2PDF_DATA_DIRの親に
# backups/ と restore-tests/ を作り、14日間保持する。
# SERVER_BACKUP_DIR=/opt/pic2pdf-viewer/backups
# SERVER_BACKUP_RETENTION_DAYS=14
# SERVER_RESTORE_TEST_DIR=/opt/pic2pdf-viewer/restore-tests

# OCR venv の Python 実行ファイルパス。
# 省略時: Windows → D:\61.tool\common\ocr\venv\Scripts\python.exe
#          Linux/Mac → ~/.venv/ocr/bin/python
# OCR_PYTHON=D:\61.tool\common\ocr\venv\Scripts\python.exe

# OCR パッケージディレクトリ（ocr_engine.py が置かれた common/ocr/ パス）。
# 省略時: D:\61.tool\common\ocr
# OCR_PACKAGE_PATH=D:\61.tool\common\ocr

# 小説OCRエンジン。既定は Surya OCR 2。yomitoku は比較・後方互換用。
OCR_ENGINE=surya2

# Surya OCR 2（Windows CUDA / llama.cpp）。既存サーバーへ接続できない場合、
# 以下の3ファイルから worker が llama-server を自動起動し、バッチ終了時に停止する。
SURYA_INFERENCE_URL=http://127.0.0.1:8768/v1
SURYA_MODEL=surya-ocr-2
# model + mmproj + llama.cpp の固定版を識別する文字列（ocr_runsへ保存）
SURYA_MODEL_REVISION=surya2-f16@<model-sha256>+mmproj@<mmproj-sha256>+llama@<build>
# SURYA_LLAMA_SERVER_PATH=C:\path\to\llama-server.exe
# SURYA_MODEL_PATH=D:\61.tool\common\ocr\models\surya2\surya-ocr-2-f16.gguf
# SURYA_MMPROJ_PATH=D:\61.tool\common\ocr\models\surya2\surya-2-mmproj.gguf
SURYA_REQUEST_TIMEOUT_SEC=600
SURYA_MAX_ATTEMPTS=3
OCR_QUALITY_MIN_INK_COVERAGE=0.85

# Kindle 小説キャプチャの画像出力先。
# 省略時: <PIC2PDF_DATA_DIR>/kindle_novel/images
# 設定すると kindle-pdf/novel_capturer.py の保存先と backend の配信先（StaticFiles）が
# 同じディレクトリを参照する。
# KINDLE_NOVEL_IMAGES_DIR=D:\kindle_novel\images

# ========================================
# フロントエンド (React/Vite) 用の設定
# ※ VITE_ プレフィックスの変数はフロントエンドのビルドに埋め込まれます
# ========================================

# クライアントからアクセスするAPIのベースURL。
VITE_API_URL=http://localhost:8766

# PDF生成機能で使用するデフォルトのソースディレクトリパス（省略可）。
VITE_DEFAULT_SOURCE_DIR=

# Generator API の向き先（省略時: 同一オリジン）。
# Linux にデプロイした frontend から Windows バックエンドに向ける場合に指定。
# 例: VITE_GENERATE_API_URL=http://100.76.210.48:8090
# VITE_GENERATE_API_URL=

# ========================================
# Linux サーバー自動同期（生成完了後）
# ========================================

# "true" に設定すると生成完了後に Linux サーバーへ自動転送する（Windows 専用設定）。
# LINUX_SYNC_ENABLED=true

# Linux サーバーの SSH ホスト名（デフォルト: medaroserver）。
# LINUX_SYNC_HOST=medaroserver

# SSH ユーザー名（デフォルト: amashio）。
# LINUX_SYNC_USER=amashio

# Linux 側のデータルートパス（デフォルト: /opt/pic2pdf-viewer/data）。
# LINUX_SYNC_DEST_DIR=/opt/pic2pdf-viewer/data

# ========================================
# hitomi 新着監視の Discord 通知
# ========================================

# 設定すると hitomi 監視の実行ごとに新着件数を Discord に通知する（0 件でも送信）。
# 手動 API（/hitomi/run-now）・systemd 定期・Task Scheduler の全経路が対象。
# 未設定なら通知は無効。Discord チャンネルの Webhook URL を指定する。
# HITOMI_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy
