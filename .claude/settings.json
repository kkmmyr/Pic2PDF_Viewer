{
  "permissions": {
    "allow": [
      "Read(**)",
      "WebFetch(domain:zenn.dev)",

      "mcp__gemma-local__ask_gemma",
      "mcp__gemma-local__explain_code",
      "mcp__gemma-local__generate_code",
      "mcp__gemma-local__translate_text",
      "mcp__gemma-local__analyze_image",

      "Bash(uv --version)",
      "Bash(npm --version)",
      "Bash(pip list)",
      "Bash(pip list *)",
      "Bash(npm audit)",
      "Bash(npm audit *)",

      "Bash(where *)",
      "Bash(wmic *)",
      "Bash(systeminfo)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi *)",

      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit)",

      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git stash list)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_docs_update.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_tests.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_deps_install.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint_check.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
