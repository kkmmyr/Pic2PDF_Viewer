{
  "permissions": {
    "allow": [
      "WebFetch(domain:zenn.dev)",

      "mcp__gemma-local__ask_gemma",
      "mcp__gemma-local__explain_code",
      "mcp__gemma-local__generate_code",
      "mcp__gemma-local__translate_text",
      "mcp__gemma-local__analyze_image",

      "Bash(uv --version)",
      "Bash(npm --version)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(pip list)",
      "Bash(pip list *)",
      "Bash(where *)",
      "Bash(wmic *)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi *)",

      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check_docs_updated.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_tests.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_deps_install.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
