      "mcp__gemma-local__explain_code",
      "mcp__gemma-local__generate_code",
      "mcp__gemma-local__translate_text",
      "mcp__gemma-local__analyze_image",
      "mcp__qwen-local__ask_qwen",
      "mcp__qwen-local__analyze_code",
      "mcp__qwen-local__analyze_long_text",
      "Bash(uv --version)",
      "Bash(npm --version)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(where *)",
      "Bash(wmic *)",
      "Bash(systeminfo)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format)",
      "Bash(uv run ruff format *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run format)",
      "Bash(npm run format *)",
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "Bash(npx --yes knip)",
      "Bash(npx --yes knip *)",
      "Bash(cd * && uv run pytest*)",
      "Bash(cd * && uv run ruff*)",
      "Bash(cd * && npx tsc*)",
      "Bash(cd * && npm run test*)",
      "Bash(cd * && npm run lint*)",
      "Bash(cd * && npm run format*)",
      "Bash(cd * && npm run build*)",
      "Bash(cd * && npx vitest*)",
      "Bash(cd * && git log*)",
      "Bash(cd * && git status*)",
      "Bash(cd * && git diff*)",
      "Bash(cd * && git show*)",
      "Bash(cd * && git branch*)",
      "Bash(cd * && git stash*)",
      "Bash(cd * && git add*)",
      "Bash(cd * && git commit*)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "PowerShell(cd *; uv run pytest*)",
      "PowerShell(cd *; uv run ruff*)",
      "PowerShell(cd *; npx tsc*)",
      "PowerShell(cd *; npm run test*)",
      "PowerShell(cd *; npm run lint*)",
      "PowerShell(cd *; npm run format*)",
      "PowerShell(cd *; npm run build*)",
      "PowerShell(cd *; npx vitest*)",
      "PowerShell(cd *; npx prettier*)",
      "PowerShell(cd *; git log*)",
      "PowerShell(cd *; git status*)",
      "PowerShell(cd *; git status ; git diff*)",
      "PowerShell(cd *; git diff*)",
      "PowerShell(cd *; git show*)",
      "PowerShell(cd *; git branch*)",
      "PowerShell(cd *; git stash*)",
      "PowerShell(cd *; git add*)",
      "PowerShell(cd *; git commit*)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-ChildItem)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Test-Path *)",
      "PowerShell(jq *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(sort)",
      "Bash(sort *)",
      "Bash(head)",
      "Bash(head *)",
      "Bash(cmd /c *)",
      "Bash(npx prettier)",
      "Bash(npx prettier *)",
      "Bash(git mv)",
      "Bash(git mv *)",
      "Bash(git rm)",
      "Bash(git rm *)",
      "Bash(git checkout)",
      "Bash(git checkout *)",
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(cd *; uv run pytest*)",
      "Bash(cd *; uv run ruff*)",
      "Bash(cd *; npx prettier*)",
      "Bash(cd *; npx tsc*)",
      "Bash(cd *; npm run test*)",
      "Bash(cd *; npm run lint*)",
      "Bash(cd *; npm run format*)",
      "PowerShell(cmd /c *)",
      "PowerShell(uv run *)",
      "PowerShell(npx *)",
      "PowerShell(git log *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git mv *)",
      "PowerShell(git rm *)",
      "PowerShell(git checkout *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(cd *; git mv*)",
      "PowerShell(cd *; git rm*)",
      "PowerShell(cd *; git checkout*)",
      "PowerShell(cd *; git merge*)",
      "PowerShell(cd *; git rebase*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_docs_update.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash .claude/hooks/remind_memory_sync.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_tests.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_deps_install.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint_check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/mkdocs_build.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
