{
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Read(**)",
      "WebFetch(domain:zenn.dev)",
      "mcp__gemma-local__ask_gemma",
      "mcp__gemma-local__explain_code",
      "mcp__gemma-local__generate_code",
      "mcp__gemma-local__translate_text",
      "mcp__gemma-local__analyze_image",
      "mcp__qwen-local__ask_qwen",
      "mcp__qwen-local__analyze_code",
      "mcp__qwen-local__analyze_long_text",
      "Bash(uv --version)",
      "Bash(npm --version)",
      "Bash(npm audit)",
      "Bash(npm audit *)",
      "Bash(where *)",
      "Bash(wmic *)",
      "Bash(systeminfo)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format)",
      "Bash(uv run ruff format *)",
      "Bash(npx vitest run)",
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run format)",
      "Bash(npm run format *)",
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "Bash(npx --yes knip)",
      "Bash(npx --yes knip *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git stash)",
      "Bash(git stash *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_docs_update.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash .claude/hooks/remind_memory_sync.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_tests.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/remind_deps_install.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint_check.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/mkdocs_build.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
